# PPT Validator AI - Environment Configuration Example
# Copy this file to .env and insert your real credentials.
# Do NOT commit .env with real secrets to version control.

# Google Gemini API Key (e.g. from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Default AI provider: "gemini" | "openai" | "heuristic"
DEFAULT_AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o-mini

# Backend Storage Paths (Relative to project root or absolute)
STORAGE_DIR=backend/storage
UPLOADS_DIR=backend/storage/uploads
SLIDES_DIR=backend/storage/slides
REPORTS_DIR=backend/storage/reports
DB_PATH=backend/ppt_validator.db

# Application Settings
DEBUG=true
MAX_FILE_SIZE_MB=50
